{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rust-ai-builder/schemas/experiment.schema.json",
  "title": "ExperimentRecord",
  "description": "Empirical test or reproducibility verification in Rust building mechanics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "hypothesis",
    "procedure",
    "observed_result",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "INBOX",
        "PROCESSING",
        "PROPOSED",
        "VERIFIED",
        "OUTDATED",
        "REJECTED"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "server_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_server": {
          "type": [
            "string",
            "null"
          ]
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "observed_result": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "related_knowledge": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(KNW|CMP|MEC|BLD|EXP)-[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "game_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
